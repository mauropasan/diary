APP_NAME=Diario
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set APP_URL to your public origin (https://example.com) so generated URLs
# and cookies are correct. Use https in production.
APP_URL=https://example.com
APP_TIMEZONE=Europe/Madrid

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database connection. SQLite is the default and requires no extra setup.
# To use MySQL/MariaDB instead, set DB_CONNECTION=mysql (or mariadb) and
# fill in the credentials below. The diary:backup command supports both.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=diary
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS (the recommended default).
SESSION_SECURE_COOKIE=true

# Restrict browser API access to your app origin and the Capacitor shell.
# Comma-separated list of origins; leave unset to derive from APP_URL.
# CORS_ALLOWED_ORIGINS=https://example.com,capacitor://localhost

# Inertia DevTools is for local development only. Leave disabled in
# production; set INERTIA_DEVTOOLS_ENABLED=true only on a trusted local
# machine.
INERTIA_DEVTOOLS_ENABLED=false

DIARY_LOCK_AFTER_MINUTES=15

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Android release signing (used by scripts/apk.sh)
DIARY_KEYSTORE_PASSWORD=
DIARY_KEY_ALIAS=diary
DIARY_KEY_PASSWORD=
