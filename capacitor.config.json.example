{
    "appId": "es.diario.app",
    "appName": "Diario",
    "webDir": "www",
    "server": {
        "androidScheme": "https",
        "cleartext": false
    },
    "plugins": {
        "StatusBar": {
            "overlaysWebView": true
        },
        "SplashScreen": {
            "launchShowDuration": 400,
            "launchAutoHide": true,
            "androidScaleType": "CENTER_CROP",
            "backgroundColor": "#111827",
            "showSpinner": false
        }
    }
}
