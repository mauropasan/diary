{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "cap:init": "cap add android",
        "cap:sync": "npm run build:native && cap sync android",
        "cap:open": "cap open android",
        "apk:debug": "npm run build:native && cap sync android && cd android && ./gradlew assembleDebug",
        "apk:release": "bash scripts/apk.sh",
        "build:native": "vite build --config vite.native.config.ts"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/app": "^8.1.2",
        "@capacitor/browser": "^8.0.5",
        "@capacitor/cli": "^8.5.3",
        "@capacitor/core": "^8.5.3",
        "@capacitor/filesystem": "^8.1.5",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/share": "^8.0.3",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.4",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@tailwindcss/vite": "^4.1.11",
        "@tiptap/extension-placeholder": "^3.31.4",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/react": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "@types/libsodium-wrappers": "^0.7.14",
        "@vitejs/plugin-react": "^6.1.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dexie": "^4.4.6",
        "dompurify": "^3.4.17",
        "i18next": "^26.4.3",
        "laravel-vite-plugin": "^3.1",
        "libsodium-wrappers": "^0.8.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-i18next": "^17.0.16",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "typescript": "^5.7.2",
        "vite-plus": "0.3.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
